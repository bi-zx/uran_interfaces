{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uran:interfaces:motion:arm-pose:1.0",
  "type": "object",
  "required": ["kind", "frame_id", "position_m", "orientation_xyzw"],
  "properties": {
    "kind": {"const": "arm_pose"},
