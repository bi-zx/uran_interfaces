{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uran:interfaces:operations:event:1.0",
  "title": "Operation lifecycle event",
  "type": "object",
  "required": ["schema_version", "operation_id", "target", "sequence", "phase", "timestamp_ns"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "operation_id": {"type": "string", "minLength": 1},
    "target": {"$ref": "urn:uran:interfaces:common:target:1.0"},
    "sequence": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "phase": {"enum": ["accepted", "running", "succeeded", "failed", "cancelled", "rejected"]},
    "timestamp_ns": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "progress": {"type": "number", "minimum": 0, "maximum": 1},
    "cancellable": {"type": "boolean"},
    "code": {"type": "string"},
    "message": {"type": "string"},
    "result": {}
  },
  "additionalProperties": false
}
