{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uran:interfaces:operations:cancel:1.0",
  "title": "Operation cancellation request",
  "type": "object",
  "required": ["schema_version", "operation_id", "target", "requested_by", "timestamp_ns"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "operation_id": {"type": "string", "minLength": 1},
    "target": {"$ref": "urn:uran:interfaces:common:target:1.0"},
    "requested_by": {"type": "string", "minLength": 1},
    "timestamp_ns": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "reason": {"type": "string"}
  },
  "additionalProperties": false
}
