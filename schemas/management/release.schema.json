{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uran:interfaces:management:release:1.0",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "release_id",
    "profile_id",
    "profile_version",
    "api_version",
    "state_schema",
    "platform",
    "artifact",
    "native_abi"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "release"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "profile_version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "api_version": {
      "const": "2.1"
    },
    "state_schema": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "platform": {
      "type": "object",
      "required": [
        "os",
        "arch"
      ],
      "properties": {
        "os": {
          "const": "Linux"
        },
        "arch": {
          "type": "string"
        },
        "os_version": {
          "type": "string"
        },
        "libc": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string"
          }
        },
        "python": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "distribution": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": [
        "url",
        "sha256",
        "size"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "size": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "native_abi": {
      "const": 3
    }
  },
  "additionalProperties": false
}
