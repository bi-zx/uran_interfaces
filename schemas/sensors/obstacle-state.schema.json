{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:uran:interfaces:sensors:obstacle-state:1.0",
  "type": "object",
  "required": ["schema_version", "source", "timestamp_ns", "frame_id", "blocked", "nearest_distance_m"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source": {"$ref": "urn:uran:interfaces:common:target:1.0"},
    "timestamp_ns": {"type": "integer", "minimum": 0},
    "frame_id": {"type": "string", "minLength": 1},
    "blocked": {"type": "boolean"},
    "nearest_distance_m": {"type": "number", "minimum": 0},
    "quality": {"type": "number", "minimum": 0, "maximum": 1}
  },
  "additionalProperties": false
}
